# Publish application source only; keep local research and raw assets private.
/*
!/.github/
!/.gitignore
!/.gitattributes
!/.node-version
!/.env.example
!/README.md
!/THIRD-PARTY-NOTICES.md
!/package.json
!/package-lock.json
!/astro.config.mjs
!/tsconfig.json
!/playwright.config.ts
!/src/
!/public/
!/scripts/
!/tests/
!/docs/

# Public documentation and portable tooling only.
/docs/*
!/docs/deployment.md
!/docs/content-authoring.md
/scripts/audit-component-motion-handoff.mjs
/scripts/capture-entry-clock-trial.mjs
/scripts/prepare-personal-media.mjs
/src/content/projects/*/docker-readiness.md

node_modules/
dist/
.astro/
.npm-cache/
.qa/
tests/.output/
test-results/
playwright-report/
*.log
.DS_Store
Thumbs.db
.env
.env.*
!.env.example
