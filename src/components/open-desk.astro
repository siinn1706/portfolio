---
import { messages } from '../i18n/messages';
import { route } from '../i18n/routes';
import Figure from './evidence-figure.astro';
import type { Locale } from '../data/types';
import type { PublicProject } from '../lib/catalog';
interface Props { project: PublicProject; locale: Locale; instanceId: string; eager?: boolean }
const { project, locale, instanceId, eager = false } = Astro.props;
const m = messages[locale];
const p = project.prose[locale];
const id = `${instanceId}-${project.projectId}`;
const href = route(locale, 'project', project.routeSlug, import.meta.env.BASE_URL);
---
<article class="open-desk" id={id} data-open-desk data-project-id={project.projectId} aria-labelledby={`${id}--title`}>
 <div class="desk-title" data-component-motion="article-title"><div><h2 id={`${id}--title`}>{p.title}</h2></div><a class="circle-link" href={href} aria-label={`${m.viewProject}: ${p.title}`}><span aria-hidden="true">↗</span></a></div>
 <p class="desk-role" data-component-motion="article-role">{p.contributionText}</p>
 <div class="desk-tabs" data-desk-tabs aria-label={`${m.projectSections}: ${p.title}`} hidden>
  <button type="button" id={`${id}--tab-context`} data-panel="context">{m.contextTab}</button><button type="button" id={`${id}--tab-decisions`} data-panel="decisions">{m.decisionsTab}</button><button type="button" id={`${id}--tab-output`} data-panel="output">{m.outputTab}</button>
 </div>
 <div class="desk-panels">
  <section id={`${id}--panel-context`} data-desk-panel="context" data-component-motion="article-panel"><h3>{m.contextTab}</h3><p>{p.context}</p><p class="desk-note">{p.summary}</p></section>
  <section id={`${id}--panel-decisions`} data-desk-panel="decisions" data-component-motion="article-panel"><h3>{m.decisionsTab}</h3><p>{p.decisionSummary}</p><a class="text-link" href={href}>{m.architectureHeading} ↗</a></section>
  <section id={`${id}--panel-output`} data-desk-panel="output" data-component-motion="article-panel"><h3>{m.outputTab}</h3>{project.heroMediaId?<Figure mediaId={project.heroMediaId} locale={locale} eager={eager} compact/>:<p>{p.summary}</p>}</section>
 </div>
 <div class="desk-footer" data-component-motion="article-footer"><span>{project.kind === 'lab' ? m.labType : m.projectType} · {project.heroMediaId ? m.localInterface : m.outputHeading}</span><a class="text-link" href={href}>{m.viewProject} <span aria-hidden="true">↗</span></a></div>
</article>
