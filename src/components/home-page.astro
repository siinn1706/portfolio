---
import Base from '../layouts/base-layout.astro';
import FeaturedProjects from './featured-projects.astro';
import Contact from './contact-links.astro';
import PersonalImage from './personal-image.astro';
import { profile } from '../data/profile';
import { getPersonalMedia } from '../data/personal-media';
import { messages } from '../i18n/messages';
import { route } from '../i18n/routes';
import { getPublicCatalog } from '../lib/get-public-catalog';
import { getFeaturedProjects } from '../lib/catalog-navigation';
import type { Locale } from '../data/types';

interface Props { locale: Locale }
const { locale } = Astro.props;
const catalog = await getPublicCatalog();
const featuredProjects = getFeaturedProjects(catalog);
const m = messages[locale];
const base = import.meta.env.BASE_URL;
const hasAvatar = getPersonalMedia('avatar', locale) !== null;
const hasPortrait = getPersonalMedia('homePortrait', locale) !== null;
---
<Base locale={locale} title={m.homeSeoTitle} description={m.homeSeoDescription} catalog={catalog}>
  <section class="hero wrap" aria-labelledby="home-heading">
    <div class:list={['identity-strip', { 'identity-strip--with-avatar': hasAvatar }]} data-component-motion="identity">
      <PersonalImage slot="avatar" locale={locale} />
      <p><strong>{profile.name}</strong><span>{profile.eyebrow[locale]}</span></p>
    </div>
    <div class:list={['hero-layout', { 'hero-layout--with-portrait': hasPortrait }]}>
      <div class="identity">
        <h1 id="home-heading" data-component-motion="headline">{profile.headline[locale].map((segment, index) => <><span class:list={{ 'muted-heading': index > 0 }}>{segment}</span>{' '}</>)}</h1>
        <p class="hero-intro" data-component-motion="support">{profile.intro[locale]}</p>
        <div class="hero-actions" data-component-motion="support">
          <a class="hero-about-link" href={route(locale, 'about', undefined, base)}>{m.heroAboutCta}<span aria-hidden="true">↗</span></a>
          <a class="text-link hero-cta" href={route(locale, 'work', undefined, base)}>{m.heroCta}<span aria-hidden="true">↗</span></a>
        </div>
      </div>
      {hasPortrait && <figure class="hero-portrait" data-component-motion="portrait"><PersonalImage slot="homePortrait" locale={locale} /></figure>}
    </div>
  </section>

  {featuredProjects.length > 0 && <section class="work-section home-projects section" id="projects" aria-labelledby="home-projects-heading">
    <div class="wrap">
      <div class="section-heading">
        <h2 id="home-projects-heading">{m.aboutProjectsHeading}</h2>
        <a class="text-link" href={route(locale, 'work', undefined, base)}>{m.viewAllProjects}<span aria-hidden="true">↗</span></a>
      </div>
      <FeaturedProjects projects={featuredProjects} locale={locale} instanceId="home-featured" />
    </div>
  </section>}

  <Contact locale={locale} />
</Base>
