---
import { getPhotoMedia } from '../data/photography-media';
import { messages } from '../i18n/messages';
import { assetUrl } from '../i18n/routes';
import type { Locale } from '../data/types';
import type { PublicPhoto } from '../lib/catalog';

interface Props { locale: Locale; photos: PublicPhoto[]; }
const { locale, photos } = Astro.props;
const m = messages[locale];
const base = import.meta.env.BASE_URL;
const selected = photos.map(photo => ({ photo, media: getPhotoMedia(photo.mediaId, locale) }));
---
<div class="photo-grid">
  {selected.map(({ photo, media }) => <figure data-photo-id={photo.photoId}>
    <a class="image-link" href={assetUrl(media.full.src, base)} aria-label={`${m.fullImage}: ${photo.title[locale]}`}><img src={assetUrl(media.image.src, base)} srcset={media.sources.map(image => `${assetUrl(image.src, base)} ${image.width}w`).join(', ')} sizes="(min-width: 1024px) 44vw, 90vw" width={photo.width} height={photo.height} alt={photo.alt[locale]} loading="lazy" decoding="async" /></a>
    <figcaption><h2>{photo.title[locale]}</h2><p>{photo.caption[locale]}</p>{photo.location && <p>{photo.location[locale]}</p>}{photo.takenAt && <time datetime={photo.takenAt}>{new Intl.DateTimeFormat(locale === 'vi' ? 'vi-VN' : 'en-GB', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${photo.takenAt}T00:00:00Z`))}</time>}<a class="text-link" href={assetUrl(media.full.src, base)}>{m.fullImage} <span aria-hidden="true">↗</span></a></figcaption>
  </figure>)}
</div>

<style>
  figcaption {
    padding-top: 24px;
  }
  figcaption h2 {
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    line-height: 1.3;
    margin-bottom: 12px;
  }
  figcaption p {
    max-width: 60ch;
  }
  figcaption .text-link {
    margin-top: 16px;
  }
</style>
