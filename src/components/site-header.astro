---
import navigationSource from '../scripts/navigation.ts?raw';
import { inlineScript } from '../lib/inline-script';
import {messages} from '../i18n/messages';import {route} from '../i18n/routes';import type {PageKey} from '../i18n/routes';import type {Locale} from '../data/types';import type {PublicCatalog} from '../lib/catalog';
interface Props{locale:Locale;pageKey:PageKey;slug?:string;catalog:PublicCatalog}
const {locale,pageKey,slug,catalog}=Astro.props;const m=messages[locale];const base=import.meta.env.BASE_URL;
const links=[{key:'work' as const,label:m.work},{key:'about' as const,label:m.about},...(catalog.notes.length?[{key:'notes' as const,label:m.notes}]:[])];
---
<header class="site-header wrap" id="top">
 <a class="wordmark" href={route(locale,'home',undefined,base)} aria-label={`Nguyễn Văn Nam — ${m.home}`}>NAM<span aria-hidden="true">·</span></a>
 <div class="header-controls">
  <span data-glass-backing aria-hidden="true"></span><span data-glass-rim aria-hidden="true"></span>
  <button class="menu-toggle" data-menu-toggle hidden aria-controls="site-navigation" aria-expanded="false">{m.menu}</button>
  <nav id="site-navigation" class="main-nav" aria-label={m.mainNavigation}>
   {links.map(link=><a href={route(locale,link.key,undefined,base)} aria-current={(pageKey===link.key||(link.key==='work'&&pageKey==='project')||(link.key==='notes'&&pageKey==='note'))?'page':undefined}><span data-component-motion="menu-label">{link.label}</span></a>)}
   <a href={route(locale,'home',undefined,base,'contact')}><span data-component-motion="menu-label">{m.contact}<span aria-hidden="true"> ↗</span></span></a>
  </nav>
  <nav class="locale-nav" aria-label={m.language}>
   <a href={route('vi',pageKey,slug,base)} lang="vi" hreflang="vi" aria-label={m.switchToVi} aria-current={locale==='vi'?'true':undefined}>VI</a><span aria-hidden="true">/</span><a href={route('en',pageKey,slug,base)} lang="en" hreflang="en" aria-label={m.switchToEn} aria-current={locale==='en'?'true':undefined}>EN</a>
  </nav>
 </div>
</header>
<script is:inline set:html={inlineScript(navigationSource)}></script>
