---
import {messages} from '../i18n/messages';import {route} from '../i18n/routes';import type {Locale} from '../data/types';import type {PublicCatalog} from '../lib/catalog';
interface Props{locale:Locale;catalog:PublicCatalog}const {locale,catalog}=Astro.props;const m=messages[locale];const base=import.meta.env.BASE_URL;
---
<footer class="site-footer wrap"><a href={route(locale,'home',undefined,base)}>Nguyễn Văn Nam</a><div>{catalog.photos.length>0&&<a href={route(locale,'photography',undefined,base)}>{m.photography}</a>}<a href={route(locale,'home',undefined,base,'contact')}>{m.contact}</a><a href="#top">{m.backToTop} <span aria-hidden="true">↑</span></a></div>
</footer>
