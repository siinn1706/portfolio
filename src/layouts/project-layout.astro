---
import { getEntry, render } from 'astro:content';
import Base from './base-layout.astro';
import Figure from '../components/evidence-figure.astro';
import ReadingTools from '../components/reading-tools.astro';
import ReadingHeading from '../components/reading-heading.astro';
import PrintContext from '../components/print-context.astro';
import RelatedContent from '../components/related-content.astro';
import ReadingToc from '../components/reading-toc.astro';
import CaseContact from '../components/case-contact.astro';
import { figureFragment, readingToc, resolveReadingSections } from '../data/reading-sections';
import { messages } from '../i18n/messages';
import { route } from '../i18n/routes';
import { profile } from '../data/profile';
import { getShareMedia } from '../data/share-media';
import { getNextProject, getRelatedContent } from '../lib/catalog-navigation';
import { readingMinutes } from '../lib/reading';
import type { Locale } from '../data/types';
import type { PublicCatalog, PublicProject } from '../lib/catalog';
interface Props { project: PublicProject; locale: Locale; catalog: PublicCatalog }
const { project, locale, catalog } = Astro.props;
const p = project.prose[locale];
const m = messages[locale];
const entry = await getEntry('projects', `${locale}/${project.projectId}`);
if (!entry) throw new Error(`Missing project ${project.projectId}/${locale}`);
const { Content, headings } = await render(entry);
const next = getNextProject(catalog, project.projectId);
const base = import.meta.env.BASE_URL;
const evidenceIds = project.mediaIds.filter(id => id !== project.heroMediaId);
const related = getRelatedContent(catalog, {kind: project.kind, id: project.projectId}, locale, base);
const minutes = readingMinutes(entry.body ?? '', locale);
const counterpartLocale = locale === 'vi' ? 'en' : 'vi';
const counterpartEntry = await getEntry('projects', `${counterpartLocale}/${project.projectId}`);
const counterpartHeadings = counterpartEntry ? (await render(counterpartEntry)).headings : [];
const supplemental = [ ...(evidenceIds.length ? ['project-evidence'] : []), ...project.mediaIds.map(figureFragment) ];
const sections = resolveReadingSections(`${project.kind}:${project.projectId}`, locale, [...headings.map(h => h.slug), ...supplemental], [...counterpartHeadings.map(h => h.slug), ...supplemental], project.mediaIds);
const toc = readingToc(headings, sections, locale);
if (evidenceIds.length) toc.push({ depth: 2, slug: 'project-evidence', text: m.evidenceGalleryHeading, children: [] });
const quick = sections.filter(section => section.quick).slice(0, 3);
const contentDate = project.contentUpdatedAt && new Intl.DateTimeFormat(locale === 'vi' ? 'vi-VN' : 'en-GB', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${project.contentUpdatedAt}T00:00:00Z`));
---
<Base locale={locale} pageKey="project" slug={project.routeSlug} title={`${p.title} — ${profile.name}`} description={p.seoDescription} catalog={catalog} image={getShareMedia(project.projectId, locale)}>
  <article class="case-page paper" data-case-id={project.projectId}>
    <header class="case-heading wrap" data-component-motion="case-heading">
      <a class="text-link" href={route(locale,'work',undefined,base)}>← {m.workTitle}</a>
      <p class="eyebrow">{project.kind === 'lab' ? 'Lab' : m.projectType}</p>
      <h1>{p.title}</h1>
      <div class="case-intro"><p>{p.summary}</p><div><p class="eyebrow">{project.kind === 'lab' ? m.labRoles : m.contribution}</p><p>{p.contributionText}</p></div></div>
      <p class="reading-estimate">{locale === 'vi' ? `Khoảng ${minutes} phút đọc` : `About ${minutes} min read`}</p>
      {contentDate && <p class="case-updated">{m.updatedLabel} <time datetime={project.contentUpdatedAt}>{contentDate}</time></p>}
      {quick.length > 0 && <nav class="case-shortcuts" aria-label={locale === 'vi' ? 'Đọc nhanh dự án' : 'Quick project reading'}>{quick.map(section => <a href={`#${section.slugs[locale]}`}>{section.quick?.[locale]}</a>)}</nav>}
      <div class="case-meta"><p><span>{m.projectStack}</span>{project.verifiedStack.join(' · ')}</p>{project.repository && <a class="text-link" href={project.repository}>{m.sourceCode}: {p.title} ↗</a>}</div>
      {project.kind === 'lab' && <aside class="lab-provenance" aria-label={locale === 'vi' ? 'Phạm vi thử nghiệm' : 'Experiment scope'}>
        <p><strong>{locale === 'vi' ? 'Chuẩn bị' : 'Prepared by'}:</strong> {project.provenance.preparedBy[locale]} · <strong>{locale === 'vi' ? 'Thực hiện' : 'Run by'}:</strong> {project.provenance.performedBy[locale]}</p>
        <p>{project.provenance.environment[locale]} · <time datetime={project.provenance.observedAt}>{project.provenance.observedAt}</time></p>
        <p>{project.provenance.reviewStatus === 'performed-by-nam' ? (locale === 'vi' ? 'Nam đã trực tiếp thực hiện.' : 'Performed directly by Nam.') : project.provenance.reviewStatus === 'reviewed-by-nam' ? (locale === 'vi' ? 'Nam đã đọc và kiểm lại.' : 'Reviewed by Nam.') : (locale === 'vi' ? 'Nam chưa trực tiếp thực hiện hoặc kiểm lại lab này.' : 'Nam has not personally run or reviewed this lab.')}</p>
        <ul>{project.provenance.limitations[locale].map(limit => <li>{limit}</li>)}</ul>
      </aside>}
    </header>
    {project.heroMediaId && <div class="wrap case-output"><Figure mediaId={project.heroMediaId} fragment={figureFragment(project.heroMediaId)} locale={locale} eager /></div>}
    <div class="case-reading wrap">
      {toc.length >= 3 && <aside class="case-toc"><details open><summary>{m.toc}</summary><ReadingToc items={toc} label={m.toc} /></details></aside>}
      <div class="prose"><Content /><ReadingTools locale={locale} sections={sections} /></div>
    </div>
    {evidenceIds.length > 0 && <section class="case-evidence wrap" aria-labelledby="project-evidence"><div class="prose"><ReadingHeading id="project-evidence" text={m.evidenceGalleryHeading} locale={locale} /></div>{evidenceIds.map(id => <Figure mediaId={id} fragment={figureFragment(id)} locale={locale} />)}</section>}
    <div class="wrap"><RelatedContent items={related} locale={locale} /><PrintContext locale={locale} path={route(locale,'project',project.routeSlug,base)} contentDate={project.contentUpdatedAt} /></div>
    <div class="case-next wrap"><a class="text-link" href={route(locale,'work',undefined,base)}>← {m.workTitle}</a>{next && <a href={route(locale,'project',next.routeSlug,base)}><span class="eyebrow">{m.nextProject}</span><strong>{next.prose[locale].title} ↗</strong></a>}<div><a class="text-link" href={route(locale,'home',undefined,base,'contact')}>{m.contact} ↗</a><CaseContact locale={locale} title={p.title} /></div></div>
  </article>
</Base>
