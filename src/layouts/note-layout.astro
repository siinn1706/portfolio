---
import Base from './base-layout.astro';
import { messages } from '../i18n/messages';
import { route } from '../i18n/routes';
import { profile } from '../data/profile';
import type { Locale } from '../data/types';
import type { PublicCatalog, PublicNote } from '../lib/catalog';
import { getRelatedContent } from '../lib/catalog-navigation';
import { readingMinutes } from '../lib/reading';
import ReadingTools from '../components/reading-tools.astro';
import ReadingHeading from '../components/reading-heading.astro';
import PrintContext from '../components/print-context.astro';
import RelatedContent from '../components/related-content.astro';
import { getEntry, render } from 'astro:content';
import ReadingToc from '../components/reading-toc.astro';
import { readingToc, resolveReadingSections } from '../data/reading-sections';
import { noteSourceLabels } from '../data/notes';

interface Props {
  locale: Locale;
  note: PublicNote;
  catalog: PublicCatalog;
  headings?: { depth: number; slug: string; text: string }[];
  body: string;
}
const { locale, note, catalog, headings = [], body } = Astro.props;
const prose = note.prose[locale];
const m = messages[locale];
const base = import.meta.env.BASE_URL;
const counterpartLocale = locale === 'vi' ? 'en' : 'vi';
const counterpartEntry = await getEntry('notes', `${counterpartLocale}/${note.noteId}`);
const counterpartHeadings = counterpartEntry ? (await render(counterpartEntry)).headings : [];
const supplemental = note.sources.length ? ['note-references'] : [];
const sections = resolveReadingSections(`note:${note.noteId}`, locale, [...headings.map(h => h.slug), ...supplemental], [...counterpartHeadings.map(h => h.slug), ...supplemental]);
const toc = readingToc(headings, sections, locale);
const labels = note.topicIds.map(id => catalog.topics.find(topic => topic.topicId === id)?.labels[locale]).filter(Boolean);
const related = getRelatedContent(catalog, {kind: 'note', id: note.noteId}, locale, base);
const minutes = readingMinutes(body, locale);
const formatDate = (value: string) => new Intl.DateTimeFormat(locale === 'vi' ? 'vi-VN' : 'en-GB', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(`${value}T00:00:00Z`));
---
<Base locale={locale} title={`${prose.title} — ${profile.name}`} description={prose.seoDescription} pageKey="note" slug={note.routeSlug} catalog={catalog}>
  <div class="paper"><article class="wrap note-article">
    <header class="page-heading">
      <a class="text-link" href={route(locale, 'notes', undefined, base)}><span aria-hidden="true">← </span>{m.allNotes}</a>
      <h1>{prose.title}</h1>
      <p class="lead">{prose.summary}</p>
      <p class="reading-estimate">{locale === 'vi' ? `Khoảng ${minutes} phút đọc` : `About ${minutes} min read`}</p>
      <div class="note-meta">
        {note.publishedAt && <p>{m.publishedLabel} <time datetime={note.publishedAt}>{formatDate(note.publishedAt)}</time></p>}
        {note.updatedAt && note.updatedAt !== note.publishedAt && <p>{m.updatedLabel} <time datetime={note.updatedAt}>{formatDate(note.updatedAt)}</time></p>}
        {labels.length > 0 && <p>{m.topicLabel}: {labels.join(' · ')}</p>}
      </div>
    </header>
    {toc.length >= 3 && <details class="table-of-contents"><summary>{m.toc}</summary><ReadingToc items={toc} label={m.toc} /></details>}
    <div class="prose note-body"><slot /><ReadingTools locale={locale} sections={sections} /></div>
    {note.sources.length > 0 && <section class="section prose note-sources" aria-labelledby="note-references"><ReadingHeading id="note-references" text={m.references} locale={locale} /><ol>{note.sources.map(source => <li><a href={source}>{noteSourceLabels[source]?.[locale] ?? source}</a>{noteSourceLabels[source]?.[locale] && <span class="print-source-url"> — {source}</span>}</li>)}</ol></section>}
    <RelatedContent items={related} locale={locale} />
    <PrintContext locale={locale} path={route(locale,'note',note.routeSlug,base)} contentDate={note.updatedAt ?? note.publishedAt} />
    <nav class="section page-actions" aria-label={m.notesTitle}><a class="text-link" href={route(locale, 'notes', undefined, base)}>{m.allNotes} <span aria-hidden="true">↗</span></a><a class="text-link" href={route(locale, 'home', undefined, base, 'contact')}>{m.contact} <span aria-hidden="true">↗</span></a></nav>
  </article></div>
</Base>
